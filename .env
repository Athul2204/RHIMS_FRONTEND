# FIX 5: Without this, VITE_API_BASE_URL is undefined, so every axios
# request goes to "undefined/api/..." and never reaches Django.
# VITE_API_BASE_URL=https://rhims.pythonanywhere.com

VITE_API_BASE_URL=https://api.rhimshealth.com
